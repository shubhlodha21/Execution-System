# All run settings for execsys live here. Copy to .env (never commit .env):  cp .env.example .env
# scripts/start.sh and run.py read this file; strategies and tickers stay in config/settings.yaml.

# --- Required for trading -----------------------------------------------------------
IB_ACCOUNT_ID=DU0000000           # your IB paper account (DU...) or live account (U...)

# --- How to run ---------------------------------------------------------------------
RUN_MODE=paper                    # paper = signals + orders, data-only = signals only (no orders)

# --- IB Gateway / TWS connection ----------------------------------------------------
IB_HOST=127.0.0.1
IB_PORT=4002                      # 4002 Gateway paper, 4001 Gateway LIVE, 7497 TWS paper, 7496 TWS LIVE
IB_CLIENT_ID=99                   # one connection for all strategies and tickers
IB_MARKET_DATA_TYPE=realtime      # realtime | delayed | delayed-frozen | frozen

# --- Optional ------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
TELEMETRY_ENABLED=false           # true when an OpenTelemetry collector is running
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
